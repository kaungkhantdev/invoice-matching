{
  "name": "invoice-matching-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "samples": "npm run build && node dist/scripts/make-samples.js",
    "match": "npm run build && node --env-file-if-exists=.env dist/src/main.js",
    "ui": "npm run build && node --env-file-if-exists=.env dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.9.0",
    "@aws-sdk/client-textract": "^3.1175.0",
    "@napi-rs/canvas": "^1.1.1",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "pdfkit": "^0.20.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
