# Copy to .env and fill in.  (Full list and explanations: README.md → Settings)
# XML (InvoiceNow) invoices need no AI. PDF / photo / Excel / SVG invoices are read by the AI chosen here.
# The review page can also switch AI per upload.

# ── Which AI reads invoices ──────────────────────────────────────────────
#   claude = Anthropic Claude API (best accuracy; invoices are sent to Anthropic)
#   local  = a model on your own machine/server (free per invoice; invoices stay in your network)
AI_PROVIDER=claude

# ── AI_PROVIDER=claude ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_CONCURRENCY=8                 # invoices read at the same time (up to your API rate limit)

# ── AI_PROVIDER=local ───────────────────────────────────────────────────
# Defaults are for Ollama on this machine (version 0.34.1+, then: ollama pull gemma4:12b).
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   vLLM       http://localhost:8000/v1
#   llama.cpp  http://localhost:8080/v1
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=gemma4:12b           # must be a vision model to read photos and scans
# LOCAL_LLM_API=                       # ollama (default on port 11434) or openai (LM Studio, vLLM, llama.cpp)
# LOCAL_LLM_NUM_CTX=16384              # Ollama only: context size in tokens
# LOCAL_LLM_CONCURRENCY=1              # invoices read at the same time (one GPU = 1)
# LOCAL_LLM_API_KEY=                   # only if your server needs one
# LOCAL_LLM_TIMEOUT_MS=300000
# LOCAL_LLM_MAX_PDF_PAGES=5            # scanned PDF pages turned into images (extra pages are flagged)

# ── Queue ───────────────────────────────────────────────────────────────
# READ_MAX_ATTEMPTS=3                  # tries when the AI is busy/unreachable, then Review

# ── Matching rules ──────────────────────────────────────────────────────
# GST_RATE=0.09
# ROUNDING_TOLERANCE=1.00

# ── Places ──────────────────────────────────────────────────────────────
# PORT=3000
# DATA_DIR=data
# UI_STORE_DIR=output/ui
