# The page in Docker: nginx serves the built page and forwards /api to the API, so the page and the API share
# one address (no CORS). nginx fills in ${API_URL} when the container starts (http://api:3000, no "/" at the end).
server {
  listen 80;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${API_URL};
    # The page's address (localhost:8080): the API only answers addresses in its WEB_ORIGINS.
    proxy_set_header Host $http_host;
    # Uploads: the API checks each file's size itself (25 MB each), so nginx sets no limit and doesn't hold them.
    client_max_body_size 0;
    proxy_request_buffering off;
  }

  location / {
    try_files $uri /index.html;
  }
}
