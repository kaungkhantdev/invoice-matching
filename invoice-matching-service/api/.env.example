# The API's settings. Copy to .env. Only the AWS login is needed; everything else has a working default
# (all settings: README.md → Settings).

# AWS login for Textract + Bedrock: the two keys, or AWS_PROFILE (not both)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# Where the page is opened (separated by "|"). Default: the page's dev server.
# WEB_ORIGINS=http://localhost:5173|http://127.0.0.1:5173
